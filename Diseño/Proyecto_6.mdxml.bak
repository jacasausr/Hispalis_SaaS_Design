							<linkSecondEndID xmi:idref='_16_9_3d80197_1778750351708_151998_14889'/>
							<geometry>1561, 757; 1750, 657; </geometry>
						</mdElement>
					</mdOwnedViews>
				</mdElement>
			</mdElement>
