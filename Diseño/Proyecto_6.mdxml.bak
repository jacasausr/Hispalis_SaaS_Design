							<geometry>273, 245, 623, 764</geometry>
							<text>&lt;html&gt;
  &lt;head&gt;
		&lt;style&gt;
			p {padding:0px; margin:0px;}
		&lt;/style&gt;
	&lt;/head&gt;

  &lt;body&gt;
    &lt;h2&gt;
      &amp;#205;ndice del Proyecto 6 &amp;#8212; Hispalis Catering
    &lt;/h2&gt;

    &lt;h3&gt;
      CU-04: Gestionar Solicitud por Parte del Cliente
    &lt;/h3&gt;

    &lt;table cellspacing=&quot;0&quot; border=&quot;1&quot; cellpadding=&quot;5&quot;&gt;
      &lt;tr bgcolor=&quot;#336699&quot;&gt;
        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Nombre del Diagrama&lt;/font&gt;
        &lt;/th&gt;

        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Tipo&lt;/font&gt;
        &lt;/th&gt;

        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Paquete&lt;/font&gt;
        &lt;/th&gt;

        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Fecha Creaci&amp;#243;n&lt;/font&gt;
        &lt;/th&gt;

        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Fecha Modificaci&amp;#243;n&lt;/font&gt;
        &lt;/th&gt;

        &lt;th&gt;
          &lt;font color=&quot;white&quot;&gt;Documentaci&amp;#243;n&lt;/font&gt;
        &lt;/th&gt;

            &lt;/tr&gt;

      &lt;tr&gt;
                &lt;td&gt;
          Diagrama-Clase-Controlador
        &lt;/td&gt;

                &lt;td&gt;
          Clases
        &lt;/td&gt;

                &lt;td&gt;
          controlador
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          Muestra GestionSolicitudClienteServlet y su relaci&amp;#243;n con HttpServlet 
          y SolicitudService
        &lt;/td&gt;

            &lt;/tr&gt;

      &lt;tr bgcolor=&quot;#f2f2f2&quot;&gt;
                &lt;td&gt;
          Diagrama-Clase-Modelo
        &lt;/td&gt;

                &lt;td&gt;
          Clases
        &lt;/td&gt;

                &lt;td&gt;
          modelo
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          Muestra SolicitudService, SolicitudDAO, EntityManager y 
          EntityManagerFactory
        &lt;/td&gt;

            &lt;/tr&gt;

      &lt;tr&gt;
                &lt;td&gt;
          Diagrama-Clase-Entidades
        &lt;/td&gt;

                &lt;td&gt;
          Clases
        &lt;/td&gt;

                &lt;td&gt;
          modelo/entidades
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          03/04/2026
        &lt;/td&gt;

                &lt;td&gt;
          Muestra las entidades JPA Solicitud, Cliente y el enumerado 
          EstadoSolicitud
        &lt;/td&gt;

            &lt;/tr&gt;

      &lt;tr bgcolor=&quot;#f2f2f2&quot;&gt;
                &lt;td&gt;
          Diagrama-Secuencia-Acepta
        &lt;/td&gt;

